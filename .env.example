# ==============================================================================
# Sunrise Clinic Agent — LLM Configuration
# ==============================================================================

# LLM Provider to use:
# 'gemini'  -> Uses Google Gemini API (gemini-2.5-flash / gemini-1.5-flash)
# 'openai'  -> Uses OpenAI API (gpt-4o-mini / gpt-4o)
# 'auto'    -> Automatically detects which key is present
# 'none'    -> Runs deterministic engine without external API calls
LLM_PROVIDER=auto

# --- Google Gemini ---
# Get your key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI ---
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
